// MAIN
import java.util.ArrayList;

class Main{
    public static void main(String [] args){
        ArrayList<String> actions = new ArrayList<>();

        actions.add("1) Start Game");
        actions.add("2) Resume Game");
        actions.add("3) Pause Game");
        actions.add("4) End Game");

        GameMenu menu = new GameMenu(actions);
        int userChoice = menu.userPrompt();
        System.out.println("Du valgte: "+ userChoice);

        doAction(userChoice);
    }

    public static void doAction(int action){
    switch(action){
    case 1:
    System.out.println("Starting Game Now");
    break;
    case 2:
    System.out.println("Fetching Previously Saved Game Data");
    break;
    case 3:
    System.out.println("Game Paused");
    break;
    case 4:
    System.out.println("Ending Game Now");
    break;
    default:
    System.out.println("Invalid Choice of Action");
        }
    }

// GAMEMENU
import java.util.ArrayList;
import java.util.Scanner;

class GameMenu{
        private ArrayList<String> actions = new ArrayList<>();
       
            public GameMenu(ArrayList<String> actions){
                this.actions=actions;
    }
            public void displayMenu(){

                for(String action: actions){
                    System.out.println(action);
        }
    }
        public int userPrompt(){
            System.out.println("Type a number to choose an action");
            displayMenu();
            Scanner scanner = new Scanner(System.in);
            int userChoice = scanner.nextInt();
            scanner.nextLine();
            return userChoice;
        }
}

}
